// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MembershipStatus {
  MEMBER_CANDIDATE_CANDIDATE // jelölt-jelölt
  MEMBER_CANDIDATE           // jelölt
  MEMBER                     // stúdiós
  ACTIVE_ALUMNI              // aktív öregtag
  ALUMNI                     // öregtag
}

enum SyncTarget {
  AUTHENTIK
  WEBSITE
  GOOGLE_GROUP
}

enum SyncOperation {
  CREATE_USER
  UPDATE_USER
  DEACTIVATE_USER
  ADD_TO_GROUP
  REMOVE_FROM_GROUP
}

enum SyncJobStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  SKIPPED
}

enum AuditAction {
  MEMBER_CREATED
  MEMBER_UPDATED
  MEMBER_ARCHIVED
  MEMBER_REACTIVATED
  STATUS_CHANGED
  ROLE_ASSIGNED
  ROLE_CHANGED
  ROLE_REMOVED
  AVATAR_UPLOADED
  AVATAR_REMOVED
  GOOGLE_GROUP_SYNCED
  CARDDAV_TOKEN_CREATED
  CARDDAV_TOKEN_REVOKED
  APP_LINK_CREATED
  APP_LINK_UPDATED
  APP_LINK_DELETED
}

enum GoogleGroupMatchStatus {
  MATCHED          // known active member
  ARCHIVED_ON_LIST // archived member, still on list
  SECONDARY_EMAIL  // known to be a secondary address
  KNOWN_ADDRESS    // no member behind it, but recognised and accepted
  UNKNOWN          // no match found
}

// Fixed tile palette for app links. An enum rather than a colour string so nothing
// free-text can reach the CSS.
enum AppLinkAccent {
  BLUE
  TEAL
  GREEN
  AMBER
  ORANGE
  RED
  VIOLET
  PINK
}

// ─── Core Models ──────────────────────────────────────────────────────────────

// Semester format: "2025/2026/1" (autumn) or "2025/2026/2" (spring)
// Academic year notation: first year / second year / semester number (1=ősz, 2=tavasz)
// Sorts correctly as a string: "2024/2025/2" < "2025/2026/1" < "2025/2026/2"

model Member {
  id                  String                @id // Authentik user UUID, or LOCAL_MEMBER_ID_PREFIX-prefixed when there is no account

  // Identity
  firstName           String
  lastName            String
  nickname            String?
  email               String                @unique
  mobile              String?
  avatarUrl           String?               // Path to square avatar image
  portraitUrl         String?               // Path to 3:4 portrait image

  // Academic
  university          String?
  major               String?
  dormRoom            String?

  // Membership
  status              MembershipStatus      @default(MEMBER_CANDIDATE_CANDIDATE)
  joinedSemester      String                // e.g. "2025/2026/1"

  // External system links
  websiteUserId       String?               // Drupal numeric uid on bsstudio.hu

  // Soft delete / archive
  archived            Boolean               @default(false)
  archivedAt          DateTime?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Relations
  leadershipRole      LeadershipRole?
  timeline            TimelineEntry[]
  auditLogsActed      AuditLog[]            @relation("AuditActor")
  auditLogsTargeted   AuditLog[]            @relation("AuditTarget")
  syncJobs            SyncJob[]
  googleGroupEntries  GoogleGroupEntry[]
  cardDavTokens       CardDAVToken[]
}

// ─── Leadership ───────────────────────────────────────────────────────────────

model LeadershipRole {
  id                  String    @id @default(cuid())
  memberId            String    @unique
  member              Member    @relation(fields: [memberId], references: [id])
  label               String    // free text e.g. "Főszerkesztő és PR-felelős"
  // Authentik groups this role maps to
  authentikGroupIds   String[]  // array of AuthentikGroup.authentikGroupId values
}

// Known Authentik groups
model AuthentikGroup {
  authentikGroupId  String  @id // actual UUID in Authentik
  displayName       String
}

// ─── History & Audit ──────────────────────────────────────────────────────────

// Member journey timeline - milestones like promotions, role assignments/removals, archival
model TimelineEntry {
  id         String             @id @default(cuid())
  memberId   String
  member     Member             @relation(fields: [memberId], references: [id])
  action     AuditAction
  status     MembershipStatus?  // new status (for promotions)
  roleLabel  String?            // snapshot of role label (for role assign/remove)
  createdAt  DateTime           @default(now())
}

// Low-level audit log: every field change
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      Member?     @relation("AuditActor", fields: [actorId], references: [id])
  // Null for entries about no single member, like a Google Group read
  targetId   String?
  target     Member?     @relation("AuditTarget", fields: [targetId], references: [id])
  action     AuditAction
  diff       Json        // { field: { old, new } }
  createdAt  DateTime    @default(now())
}

// ─── Sync Jobs ────────────────────────────────────────────────────────────────

model SyncJob {
  id         String         @id @default(cuid())
  target     SyncTarget
  operation  SyncOperation
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id])
  payload    Json           // what we're trying to do
  status     SyncJobStatus  @default(PENDING)
  attempts   Int            @default(0)
  result     Json?          // response or error details
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ─── Google Group Reconciliation ─────────────────────────────────────────────

model GoogleGroupEntry {
  email        String                  @id
  matchStatus  GoogleGroupMatchStatus  @default(UNKNOWN)
  memberId     String?
  member       Member?                 @relation(fields: [memberId], references: [id])
  note         String?                 // e.g. "xy's secondary email"
}

// ─── CardDAV ──────────────────────────────────────────────────────────────────

// One row per device. CardDAV sends HTTP Basic on every poll, which no Authentik
// credential can answer; revoking a lost phone is deleting its row.
model CardDAVToken {
  id          String     @id @default(cuid())
  memberId    String
  member      Member     @relation(fields: [memberId], references: [id])
  label       String     // the device it was minted for, e.g. "iPhone"
  // SHA-256 of 256 random bits: nothing low-entropy to stretch, so bcrypt would only
  // cost a derivation per poll, and a digest keeps verification an index hit.
  tokenHash   String     @unique
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?

  @@index([memberId])
}

// ─── App Links ────────────────────────────────────────────────────────────────

// The studio's other applications, listed on /apps. Config rather than member data:
// no relations, and nothing here is derived from anything else.
model AppLink {
  id           String         @id @default(cuid())
  name         String
  description  String?
  url          String
  icon         String         // lucide icon name, from the curated list in lib/app-links.ts
  accent       AppLinkAccent  @default(BLUE)
  // What the dashboard shows; /apps ignores it and lists everything.
  featured     Boolean        @default(false)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}
