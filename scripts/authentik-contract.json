        "uuid": "string, uuid, readOnly, required",
        "username": "string, required",
        "name": "string, required",
        "email": "string, email, optional",
        "is_active": "boolean, optional"
      }
    }
  },
  "POST /core/groups/{group_uuid}/add_user/": {
