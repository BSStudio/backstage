        "results[].username": "string, required",
        "results[].name": "string, required",
        "results[].email": "string, email, optional",
        "results[].is_active": "boolean, optional",
        "results[].path": "string, optional",
        "results[].attributes": "object, optional",
        "results[].groups": "array<string>, optional"
      }
    }
  },
  "POST /core/users/": {
