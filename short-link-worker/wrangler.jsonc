{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bss-short-links",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Fill in the namespace id before the first deploy — see README.md.
  "kv_namespaces": [
    { "binding": "LINKS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "analytics_engine_datasets": [
    { "binding": "CLICKS", "dataset": "short_link_clicks" }
  ],
  "routes": [{ "pattern": "l.bsstudio.hu/*", "zone_name": "bsstudio.hu" }]
}
