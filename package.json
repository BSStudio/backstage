{
  "name": "backstage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "check": "biome check && tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:service": "vitest --watch tests/services",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "authentik:contract": "tsx scripts/authentik-contract.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rgrove/parse-xml": "5.0.0",
    "@sentry/nextjs": "11.7.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.7",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "18.0.7",
    "jose": "6.2.12",
    "lucide-react": "1.56.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "6.2.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prisma": "7.10.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
