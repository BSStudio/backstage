    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
