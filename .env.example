# Database
DATABASE_URL="postgresql://backstage:backstage@localhost:5432/backstage"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Authentik OIDC
AUTHENTIK_ISSUER="https://auth.yourdomain.com/application/o/backstage"
AUTHENTIK_CLIENT_ID="your-client-id"
AUTHENTIK_CLIENT_SECRET="your-client-secret"

# Authentik group names (matched against OIDC groups claim for role resolution)
AUTHENTIK_GROUP_LEADERSHIP="group-name-here"
AUTHENTIK_GROUP_ADMIN="group-name-here"

# Authentik REST API
AUTHENTIK_URL="https://auth.yourdomain.com"
AUTHENTIK_API_TOKEN="your-api-token"

# Authentik group UUIDs
AUTHENTIK_GROUP_CANDIDATE_CANDIDATE="uuid-for-candidate-candidate-group"
AUTHENTIK_GROUP_CANDIDATE="uuid-for-candidate-group"
AUTHENTIK_GROUP_MEMBER="uuid-for-member-group"
AUTHENTIK_GROUP_ALUMNI="uuid-for-alumni-group"

# Authentik UUID of the common Leadership group
AUTHENTIK_GROUP_LEADERSHIP_UUID="uuid-for-leadership-group"

# URL of the studio Google Group
NEXT_PUBLIC_GOOGLE_GROUP_URL="https://groups.google.com/g/your-group"

# Avatar storage backend: "local" (default) or "s3"
AVATAR_STORAGE="local"

# S3 settings (required when AVATAR_STORAGE=s3)
S3_BUCKET=""
S3_REGION=""
# Optional: set for S3-compatible providers (MinIO, Backblaze B2, Cloudflare R2).
# When unset, the AWS SDK derives the endpoint from S3_REGION.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Optional: omit to use the default AWS credential chain (IAM role, ~/.aws/credentials)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
