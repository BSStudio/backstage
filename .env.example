# Database
DATABASE_URL="postgresql://backstage:backstage@localhost:5432/backstage"

# Public origin of this deployment
APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Authentik login (OIDC). The same provider issues machine-to-machine tokens.
AUTHENTIK_ISSUER="https://auth.yourdomain.com/application/o/backstage"
AUTHENTIK_CLIENT_ID="your-client-id"
AUTHENTIK_CLIENT_SECRET="your-client-secret"

# Authentik REST API, used by the sync layer
AUTHENTIK_URL="https://auth.yourdomain.com"
AUTHENTIK_API_TOKEN="your-api-token"

# Authentik group names, matched against the OIDC groups claim
AUTHENTIK_GROUP_LEADERSHIP="group-name-here"
AUTHENTIK_GROUP_ADMIN="group-name-here"
AUTHENTIK_GROUP_API_CLIENTS="backstage-api-clients"
# Workstation agents, separate from the API clients above
AUTHENTIK_GROUP_COMPUTER_AGENTS="backstage-computer-agents"

# Authentik group UUIDs, used by the sync layer. Both alumni statuses share one group.
AUTHENTIK_GROUP_CANDIDATE_CANDIDATE="uuid-for-candidate-candidate-group"
AUTHENTIK_GROUP_CANDIDATE="uuid-for-candidate-group"
AUTHENTIK_GROUP_MEMBER="uuid-for-member-group"
AUTHENTIK_GROUP_ALUMNI="uuid-for-alumni-group"
# The common Leadership group. A UUID, unlike AUTHENTIK_GROUP_LEADERSHIP above.
AUTHENTIK_GROUP_LEADERSHIP_UUID="uuid-for-leadership-group"

# The outgoing Drupal site at bsstudio.hu. Leaving any of the three empty stops the
# sync: the jobs record as SKIPPED rather than failing on a missing credential.
DRUPAL_URL="https://bsstudio.hu"
DRUPAL_ADMIN_USERNAME="admin-username"
DRUPAL_ADMIN_PASSWORD="admin-password"

# Google Group reconciliation and membership sync (Cloud Identity API).
# The service account must hold the MANAGER role on the group itself. The key is the
# downloaded JSON key file, base64-encoded.
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_GROUP_EMAIL="members@yourdomain.com"
# Optional second list, joined when a member becomes an alumnus
GOOGLE_ALUMNI_GROUP_EMAIL="alumni@yourdomain.com"

# Studio calendar shown on the dashboard, read with the same service account. Share the
# calendar with its address ("See all event details"). Leave empty to drop the widget
# from the dashboard.
GOOGLE_CALENDAR_ID="studio@group.calendar.google.com"

# Studio workstations over RDP. The machine's own slug is joined onto the suffix, so nle4
# is reached at nle4.example.hu. An empty suffix drops the download from /computers.
COMPUTER_RDP_HOST_SUFFIX=""
COMPUTER_RDP_PORT="3389"
# NetBIOS name of the AD domain. Prefilled into the file as DOMAIN\<Authentik username>;
# empty leaves the file without a username.
COMPUTER_RDP_AD_DOMAIN=""

# Avatar storage backend: "local" (default) or "s3"
AVATAR_STORAGE="local"

# S3 settings (required when AVATAR_STORAGE=s3)
S3_BUCKET=""
S3_REGION=""
# Optional: set for S3-compatible providers (MinIO, Backblaze B2, Cloudflare R2).
# When unset, the AWS SDK derives the endpoint from S3_REGION.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Optional: omit to use the default AWS credential chain (IAM role, ~/.aws/credentials)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---
# Everything below is consumed by `next build`, not by the running server. `pnpm dev`
# reads it from here, but the image takes it as a build arg (docker-compose.yml,
# .github/workflows/docker-publish.yml) — setting it on the container is too late.

# Sentry error monitoring. Leave the DSN empty to disable reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=""
# Defaults to NODE_ENV when unset
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Source map upload target
SENTRY_ORG=""
SENTRY_PROJECT=""
# Passed as a BuildKit secret rather than a build arg, which would land in the image history
SENTRY_AUTH_TOKEN=""

# ---
# Dev tooling only. The running server reads none of these.

# Points `pnpm authentik:contract` at a local file or a pinned release instead of goauthentik's
# main branch. Read with ??, so leave it commented out rather than empty.
#AUTHENTIK_SCHEMA_URL=
